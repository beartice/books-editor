# Copia in .env e modifica. Usato da docker compose.
# Il file .env contiene segreti: non committarlo (chmod 600 .env).

# ---- Docker compose ----
# Indirizzo su cui ascolta l'app: 127.0.0.1 = solo questa macchina;
# 0.0.0.0 (o l'IP del server) = raggiungibile dalla rete locale.
BIND_ADDRESS=127.0.0.1
# Cartelle sull'host per la libreria (epub, copertine) e per indice e
# impostazioni. Devono appartenere all'uid 1000 (su Linux).
LIBRARY_PATH=./library
# Cartella delle librerie aggiuntive (una sottocartella per libreria).
LIBRARIES_PATH=./librerie
DATA_PATH=./data

# ---- Autenticazione ----
# Nessuna variabile necessaria: al primo avvio l'interfaccia chiede di creare
# l'account (codice di configurazione nei log: `docker compose logs libreria`,
# oppure nel file data/.setup-code). Le credenziali stanno in data/auth.json.
# Password dimenticata: cancella data/auth.json e riavvia.
#
# FACOLTATIVO: gestire le credenziali da variabili d'ambiente (hanno la
# precedenza su auth.json e non si cambiano dall'interfaccia).
# AUTH_USER=
# Hash scrypt della password. Generalo con (la password va su stdin):
#   printf '%s' 'la-tua-password' | docker compose run --rm -T libreria \
#     node server/dist/server/src/tools/hash-password.js
# Il comando stampa la riga AUTH_PASS_HASH=...
# ATTENZIONE: il valore contiene `$`, che compose interpreta come variabile.
# Racchiudilo tra APICI SINGOLI (letterale, nessuna interpolazione):
#   AUTH_PASS_HASH='scrypt$16384$8$1$salt$hash'
# in alternativa raddoppia ogni `$` (`$$`) senza apici.
# AUTH_PASS_HASH=
# DEPRECATA: password in chiaro, sconsigliata. Usa AUTH_PASS_HASH.
# AUTH_PASS=
# Solo per prove: app aperta se non esiste nessun account (sconsigliato).
# AUTH_DISABLED=1

# Segreto per firmare le sessioni, almeno 32 caratteri: openssl rand -hex 32
# Se vuoto viene generato in data/.session-secret.
SESSION_SECRET=
# Durata della sessione in giorni (default 30).
SESSION_DAYS=30

# ---- Reverse proxy ----
# Sintassi proxy-addr. Dietro nginx sull'host serve anche uniquelocal
# (il gateway della rete Docker e' in una rete privata).
TRUST_PROXY=loopback,uniquelocal
# Origini CORS consentite: lascia vuoto (l'app e' same-origin).
CORS_ORIGINS=

# ---- Import da percorso ----
# Cartelle assolute (separate da virgola) consentite per «Importa da percorso».
# Vuoto = funzione disattivata in produzione. Esempio: /import
# (monta la cartella nel compose, vedi il volume commentato).
IMPORT_ROOTS=

# Chiave API Google Books (facoltativa): evita il limite di 429 richieste/min.
# Puoi anche incollarla dall'interfaccia: Impostazioni -> Chiave API Google Books.
# https://developers.google.com/books/docs/v1/getting_started
GOOGLE_BOOKS_API_KEY=

# Dimensione massima (MB) di un file caricato dal browser (1-4096, default 300).
# Anche il reverse proxy deve accettare richieste cosi' grandi: in nginx
# `client_max_body_size` un po' sopra questo valore (es. 310m), altrimenti
# risponde 413 prima che la richiesta arrivi all'app.
MAX_UPLOAD_MB=300
# Memoria massima del container (default 2g). Alzala se alzi MAX_UPLOAD_MB.
MEM_LIMIT=2g

# Controllo dei nuovi capitoli delle fanfiction (AO3, EFP): parte da solo ogni
# notte e avvisa soltanto, l'aggiornamento lo avvii tu dalla scheda.
# `off` disattiva il controllo automatico (resta il pulsante nelle Impostazioni).
FANFIC_CHECK=on
# Ora locale (0-23) del controllo notturno e fuso orario del container.
FANFIC_CHECK_HOUR=3
TZ=Europe/Rome
# Pausa in secondi fra una richiesta e l'altra ai siti (default 6).
FANFIC_CHECK_DELAY_SEC=6

# ---- Jellyfin ----
# Jellyfin legge direttamente la cartella delle librerie (LIBRARY_PATH e
# LIBRARIES_PATH) e books-editor gli invia i metadati; indirizzo, chiave API e
# libreria Jellyfin dei libri si scelgono dalle Impostazioni.
# Se Jellyfin vede la cartella con un percorso diverso da quello del container,
# elenca le coppie `percorso visto da Jellyfin=percorso nel container`, separate
# da `;` (vince il prefisso piu' lungo). Esempio, con le cartelle sull'host in
# /srv/books-editor/library e /srv/books-editor/librerie:
# JELLYFIN_PATH_MAP="/srv/books-editor/library=/app/library;/srv/books-editor/librerie=/app/libraries"
JELLYFIN_PATH_MAP=
# Ogni quanti minuti abbinare i nuovi elementi di Jellyfin e inviare le schede
# modificate (0 = giro periodico spento; resta il pulsante nelle Impostazioni).
JELLYFIN_SYNC_MINUTES=30

# Livello di log: debug | info | warn | error
LOG_LEVEL=info

# ---- Solo uso fuori da compose (il compose li fissa gia') ----
# Porta e host
PORT=8787
HOST=0.0.0.0
# Radice della libreria e cartella dell'indice. In Docker: /app/library e /app/data
LIBRARY_ROOT=/app/library
# Cartella che contiene le librerie aggiuntive. In Docker: /app/libraries
LIBRARIES_ROOT=/app/libraries
DATA_DIR=/app/data

# Solo macOS: cartella del container di Apple Books (o di un backup non cifrato)
# da cui importare evidenziazioni e note. Se vuota si usa
# ~/Library/Containers/com.apple.iBooksX.
APPLE_BOOKS_CONTAINER=
