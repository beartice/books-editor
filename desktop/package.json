{
  "name": "books-editor-desktop",
  "productName": "Books Editor",
  "version": "2.0.0",
  "private": true,
  "description": "Books Editor per Mac e Windows: la libreria su questo computer, oppure collegata a un server.",
  "author": "Books Editor",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "npm run dist:mac-arm64",
    "dist:mac-arm64": "node build.mjs --target=darwin-arm64 && electron-builder --mac dmg --arm64",
    "dist:mac-x64": "node build.mjs --target=darwin-x64 && electron-builder --mac dmg --x64",
    "dist:win": "node build.mjs --target=win32-x64 && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "adm-zip": "^0.5.16",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "fast-xml-parser": "^4.5.1",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "io.github.books-editor",
    "productName": "Books Editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "artifactName": "Books-Editor-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Books Editor"
    },
    "extraResources": [
      {
        "from": "server-dist",
        "to": "server"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Books-Editor-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Books Editor",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "afterPack.cjs"
  }
}
