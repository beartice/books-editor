# Esempio di sito nginx per books-editor su books.example.com.
# Sostituisci books.example.com con il tuo dominio. Copia questo file in
# /etc/nginx/sites-available/books-editor (con il link in sites-enabled/) oppure
# in /etc/nginx/conf.d/books-editor.conf, senza il suffisso .example.
# Richiede anche books-editor-ratelimit.conf in /etc/nginx/conf.d/ (zone
# books_login, books_api e books_covers).
# Richiede nginx 1.25.1 o piu' recente (`http2 on;`); con versioni precedenti
# togli quella riga e scrivi `listen 443 ssl http2;`.
#
# Due varianti, cambia solo l'indirizzo dei `proxy_pass`:
#  - app sulla STESSA macchina di nginx: `proxy_pass http://127.0.0.1:8787;`
#    (e' il default del compose: BIND_ADDRESS non va impostato);
#  - app su un'ALTRA macchina (es. server dell'app 192.168.1.10, proxy
#    192.168.1.20): sostituisci 127.0.0.1 con `192.168.1.10` in tutti i
#    `proxy_pass` e nel .env dell'app imposta `BIND_ADDRESS=192.168.1.10` e
#    `TRUST_PROXY=192.168.1.20` (l'IP del proxy, mai `uniquelocal`).
#
# Prima emissione del certificato: i blocchi con `ssl_certificate` non si
# caricano finche' il certificato non esiste. Vedi README (certbot --webroot
# con il solo blocco della porta 80, oppure certbot --nginx).

server_tokens off;

# ------------------------------------------------------------ porta 80 ----
server {
    listen 80;
    listen [::]:80;
    server_name books.example.com;
    server_tokens off;

    # Sfida ACME di certbot (webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------------------------------------------- porta 443 ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name books.example.com;

    ssl_certificate     /etc/letsencrypt/live/books.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/books.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling (Let's Encrypt ha dismesso OCSP: se nginx segnala un
    # avviso in log, si possono togliere queste tre righe senza conseguenze).
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/books.example.com/chain.pem;
    resolver 1.1.1.1 9.9.9.9 valid=300s;
    resolver_timeout 5s;

    # HSTS senza `preload`: il preload e' praticamente irreversibile. `always` anche sugli errori.
    # Le altre intestazioni di sicurezza (CSP, nosniff, frame...) le imposta
    # l'app: qui NON vanno duplicate.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # L'app accetta upload fino a MAX_UPLOAD_MB (300): il limite qui sta un po' sopra.
    client_max_body_size 310m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    limit_req_status 429;

    # Impostazioni del proxy, ereditate dalle location (nessuna le ridefinisce).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    # Import EFP e ricerche online possono durare.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # File nascosti: bloccati, tranne .well-known.
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Login: limite severo (10 r/min, burst 5).
    location = /api/auth/login {
        limit_req zone=books_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }

    # Copertine: limite a parte (200 r/s, burst 1000). Con il limite delle
    # API la griglia ne perderebbe centinaia (429) a ogni apertura.
    location ^~ /api/covers/ {
        limit_req zone=books_covers burst=1000 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }

    # API: limite largo (20 r/s, burst 50).
    location /api/ {
        limit_req zone=books_api burst=50 nodelay;
        proxy_pass http://127.0.0.1:8787;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
    }
}
